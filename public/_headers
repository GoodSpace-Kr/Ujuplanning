# Pack names contain a content hash, so new footage always gets a new URL.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
/assets/sequence-packs/*
  Cache-Control: public, max-age=31536000, immutable
/assets/scroll-video/*
  Cache-Control: public, max-age=31536000, immutable

# Unversioned stills may be replaced; keep their browser cache short.
/assets/studio-sequence/*
  Cache-Control: public, max-age=3600
/assets/telescope-sequence/*
  Cache-Control: public, max-age=3600
/assets/brand-process/*
  Cache-Control: public, max-age=86400
/fonts/pretendard-1.3.9/*
  Cache-Control: public, max-age=31536000, immutable
